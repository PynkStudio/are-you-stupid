<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  A static INFOPLIST_FILE (see the NSBonjourServices comment below for
	  why this can't be GENERATE_INFOPLIST_FILE-synthesized) does NOT get
	  CFBundleIdentifier/CFBundleExecutable/CFBundlePackageType injected for
	  free the way a synthesized Info.plist does — Xcode still auto-adds
	  platform/SDK metadata (UIDeviceFamily, MinimumOSVersion, …) but not
	  these app-identity keys. Missing them doesn't fail the *build* — only
	  `simctl install`/a real device install/launch, which is exactly how
	  this went unnoticed: confirmed broken via `xcrun simctl install`
	  ("Missing bundle ID") despite `xcodebuild build` succeeding cleanly
	  every time. See docs/Meta/Decision Log.md.
	-->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Are You Stupid</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.casual-games</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!--
	  NSBonjourServices MUST be a plist array. xcodegen 2.45.4's
	  `info.properties` YAML path fails to decode array-valued properties
	  at all (a bare array under `info.properties.NSBonjourServices` makes
	  `xcodegen generate` fail with an unrelated-looking
	  `Decoding failed at "path": Nothing found` error — confirmed by
	  bisecting project.yml down to that single key). A real, static
	  Info.plist file sidesteps xcodegen's property-list YAML encoder
	  entirely. See docs/Meta/Decision Log.md.

	  Without this declared, NWListenerServer's Bonjour advertising never
	  actually broadcasts _ays-party._tcp (confirmed: an earlier attempt
	  using INFOPLIST_KEY_NSBonjourServices — which only supports scalar
	  values — silently dropped this key from the built Info.plist
	  entirely), so no phone can discover the room even on the same
	  network, even though the TCP listener still binds locally and
	  reports a port.
	-->
	<key>NSBonjourServices</key>
	<array>
		<string>_ays-party._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>ARE YOU STUPID? uses your local network to connect this board to phones in the same room.</string>
</dict>
</plist>
